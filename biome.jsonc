// biome-ignore-all format: ~~ Generated by projen. To modify, edit .projenrc.ts and run "npx projen".
{
  "assist": {
    "actions": {
      "recommended": true
    },
    "enabled": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "!biome.jsonc",
      "src/**",
      "test/**",
      ".projenrc.ts",
      "projenrc/**",
      "!.gitattributes",
      "!.github/dependabot.yml",
      "!.github/workflows/build.yml",
      "!.github/workflows/pull-request-lint.yml",
      "!.github/workflows/release.yml",
      "!.github/workflows/upgrade-main.yml",
      "!.gitignore",
      "!.mergify.yml",
      "!.projen/deps.json",
      "!.projen/files.json",
      "!.projen/tasks.json",
      "!tsconfig.dev.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "quoteProperties": "asNeeded",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "complexity": {
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "useNodejsImportProtocol": "off"
      },
      "suspicious": {
        "noConfusingVoidType": "error",
        "noShadowRestrictedNames": "off"
      }
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  },
  "overrides": [
    {
      "formatter": {
        "enabled": false
      },
      "includes": [
        "biome.jsonc"
      ],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ],
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json"
}
